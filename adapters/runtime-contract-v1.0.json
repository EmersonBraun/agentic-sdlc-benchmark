{
  "schema_version": "external-adapter-runtime-v1.0",
  "protocol_version": "v1.0",
  "command_boundary": {
    "argv_only": true,
    "shell": false,
    "workspace_containment": true,
    "stdout_and_stderr_persisted": false,
    "argv_persisted": false,
    "argv_hash_persisted": true
  },
  "permission_modes": ["deny-all", "approve-reads", "approve-all"],
  "registry_bindings": {
    "ade": "controller:benchmark_controller.ade_adapters",
    "harness": "controller:benchmark_controller.harness_adapters"
  },
  "readiness_evaluator": "controller:benchmark_controller.readiness",
  "ade_specific_bindings": {
    "agent-orchestrator": "controller:benchmark_controller.agent_orchestrator",
    "compozy": "controller:benchmark_controller.compozy",
    "orca": "controller:benchmark_controller.orca"
  },
  "harness_specific_bindings": {
    "mini-swe-agent": "controller:benchmark_controller.mini_swe"
  },
  "ledger_requirements": [
    "workspace.prepared",
    "command.executed",
    "command.blocked",
    "artifact.hashed",
    "lifecycle.transition"
  ],
  "failure_policy": "Timeouts, permission denials, path escapes, and unknown lifecycle states fail closed and remain ledger-visible."
}
